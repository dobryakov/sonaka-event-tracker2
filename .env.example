# PostgreSQL (сервис postgres в compose)
POSTGRES_USER=sonaka
POSTGRES_PASSWORD=sonaka
POSTGRES_DB=events

# Строка подключения для приложения и golang-migrate (формат postgres://)
DATABASE_URL=postgres://sonaka:sonaka@postgres:5432/events?sslmode=disable

# Явные параметры БД (удобно для PHP PDO в автотестах)
DB_HOST=postgres
DB_PORT=5432
DB_USER=sonaka
DB_PASSWORD=sonaka
DB_NAME=events

# HTTP-сервер приложения
HTTP_ADDR=:8080

# Базовый URL приёмки для клиентов и тестов (внутри compose — хост app)
INGEST_BASE_URL=http://app:8080

# Лимит тела запроса приёмки (байты); по умолчанию 1 MiB
MAX_BODY_BYTES=1048576

# Каталог SQL-миграций внутри контейнера приложения
MIGRATIONS_DIR=/app/migrations

# Только для интеграционных тестов: если true, заголовок X-Simulate-DB-Failure: 1
# на POST /events возвращает 503 без записи в БД (см. quickstart). В продакшене — false.
ALLOW_DB_FAILURE_SIMULATION=true
